NODE_ENV=production
PORT_AUTH=3001
PORT_DRIVER=3002
PORT_TRIP=3003
PORT_MATCHING=3004
PORT_PRICING=3005
PORT_REALTIME=3006

CORS_ORIGIN=http://localhost

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

MONGO_URI_AUTH=mongodb://mongo:27017/auth_db
MONGO_URI_DRIVER=mongodb://mongo:27017/driver_db
MONGO_URI_TRIP=mongodb://mongo:27017/trip_db
MONGO_URI_MATCHING=mongodb://mongo:27017/matching_db
MONGO_URI_PRICING=mongodb://mongo:27017/pricing_db
MONGO_URI_REALTIME=mongodb://mongo:27017/realtime_db

JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_long
